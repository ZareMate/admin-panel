# Bot token from the Discord application's Bot page, not an OAuth client secret.
DISCORD_BOT_TOKEN=
# Server whose visible channels should be printed at startup.
DISCORD_GUILD_ID=

# Comma-separated Discord CATEGORY IDs that contain ticket channels or forums.
TICKET_CATEGORY_IDS=
# Optional JSON overrides; unspecified categories retain their defaults.
# TICKET_RULES='{"lost-items-or-airship":{"pattern":"lost-items-or-airship-*","label":"Lost Items or Airship"}}'
# Optional outbound integration. Use the same dedicated secret on the web server.
# TICKET_SYNC_URL=wss://panel.example.com/tickets-sync
# TICKET_SYNC_TOKEN=

# Optional forum CHANNEL ID for the Suggestions tab (not its parent category).
# Uses the same TICKET_SYNC_URL and TICKET_SYNC_TOKEN connection.
SUGGESTIONS_FORUM_ID=
