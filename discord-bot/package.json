{
  "name": "admin-panel-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
