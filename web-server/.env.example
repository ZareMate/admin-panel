# URL used in the browser; no trailing slash. Provider-managed HTTPS needs no local certificates.
PUBLIC_ORIGIN=https://panel.example.com
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
# PANEL_CONFIG=./data/config/admin-panel.properties
# Use the SAME secret in Minecraft config/admin-panel-bridge.properties.
ADMIN_PANEL_BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_URL_SAFE_SECRET_OF_AT_LEAST_43_CHARACTERS
# ADMIN_PANEL_DISCORD_CLIENT_SECRET=
# Only if your reverse proxy rewrites Host/client IP: list its actual IPs or CIDRs.
# Do not trust arbitrary forwarded headers from public clients.
# TRUSTED_PROXIES=127.0.0.1,::1
# Optional Discord ticket ingestion: same random secret as the bot (43–128 URL-safe characters).
# TICKET_SYNC_TOKEN=
